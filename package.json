{
  "name": "google-lens-api",
  "version": "1.0.6",
  "private": true,
  "description": "Authenticated Google Lens search API with durable Redis-backed jobs and a Scrapling Chrome worker.",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "benchmark:offline": "tsx scripts/offline-benchmark.ts"
  },
  "dependencies": {
    "@fastify/multipart": "9.2.1",
    "fastify": "5.12.7",
    "ioredis": "5.4.1"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "4.1.11"
  }
}
