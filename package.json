{
  "name": "standalone-google-lens-api",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-testable SerpApi-compatible Google Lens service with durable storage and a Redis Streams Scrapling adapter.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "benchmark:offline": "tsx scripts/offline-benchmark.ts"
  },
  "dependencies": {
    "@fastify/multipart": "9.2.1",
    "fastify": "5.12.7",
    "ioredis": "5.4.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
