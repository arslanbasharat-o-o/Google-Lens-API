# This example is Compose-ready. For direct offline development, override the
# adapter/queue/storage values shown in README.md instead of exposing a port.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000

# Upload and execution limits
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=10000
MAX_BATCH_SIZE=100
# Aggregate multipart image bytes per request; bounds retained request memory.
MAX_BATCH_BYTES=52428800
MAX_QUEUE_SIZE=500
WORKER_CONCURRENCY=2
SEARCH_SYNC_WAIT_MS=5000
JOB_RETENTION_MS=3600000
MAX_JOB_RECORDS=5000
IMAGE_RETENTION_MS=900000
MAX_IMAGE_RECORDS=1000
IMAGE_STORAGE_BACKEND=file
IMAGE_STORAGE_DIR=/var/lib/lens/images
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500
MAX_ATTEMPTS=2
RETRY_BASE_MS=250
REMOTE_FETCH_TIMEOUT_MS=10000
REMOTE_FETCH_MAX_BYTES=10485760
REMOTE_FETCH_MAX_REDIRECTS=3

# Auth and admission controls. Replace this placeholder through the environment
# or a secret store before any externally reachable deployment.
API_AUTH_REQUIRED=true
API_KEYS=replace-with-a-random-secret
# Disabled by default: query-string credentials can leak through proxies and logs.
ALLOW_QUERY_API_KEY=false
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_STORE_MAX=10000

# Compose uses Redis for durable jobs and the Scrapling worker contract.
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379

# Compose modes are explicit and must match. Fixture mode is deterministic and
# does not contact Google; live mode additionally requires the two gates below.
LENS_DEPLOYMENT_MODE=fixture
SCRAPLING_WORKER_MODE=fixture
LENS_ADAPTER=scrapling
GOOGLE_LENS_LIVE_ENABLED=false
GOOGLE_LENS_LIVE_AUTHORIZED=false
SCRAPLING_RESULT_TIMEOUT_MS=30000
SCRAPLING_POLL_INTERVAL_MS=250
SCRAPLING_HEARTBEAT_MAX_AGE_MS=60000
SCRAPLING_HEARTBEAT_TTL_SECONDS=60
SCRAPLING_MAX_PAGES=1
SCRAPLING_BROWSER_TIMEOUT_MS=10000
GOOGLE_LENS_TARGET_URL=https://www.google.com/?olud=
SCRAPLING_HEADLESS=true

# Production image and shared RMA network settings.
LENS_API_IMAGE=ghcr.io/arslanbasharat-o-o/google-lens-api:1.0.0
LENS_WORKER_IMAGE=ghcr.io/arslanbasharat-o-o/google-lens-scrapling-worker:1.0.0
LENS_API_KEY=replace-with-a-random-secret
RMA_DOCKER_NETWORK=rma-system_rma_network

# To select the authorized live Compose mode, set all four values together:
# LENS_DEPLOYMENT_MODE=live
# SCRAPLING_WORKER_MODE=live
# GOOGLE_LENS_LIVE_ENABLED=true
# GOOGLE_LENS_LIVE_AUTHORIZED=I_UNDERSTAND_AND_AUTHORIZE
