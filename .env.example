NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Upload and execution limits
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=10000
MAX_BATCH_SIZE=100
MAX_QUEUE_SIZE=500
WORKER_CONCURRENCY=2
SEARCH_SYNC_WAIT_MS=1000
JOB_RETENTION_MS=3600000
MAX_JOB_RECORDS=5000
IMAGE_RETENTION_MS=900000
MAX_IMAGE_RECORDS=1000
IMAGE_STORAGE_BACKEND=memory
IMAGE_STORAGE_DIR=./data/images
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500
MAX_ATTEMPTS=2
RETRY_BASE_MS=250
REMOTE_FETCH_TIMEOUT_MS=10000
REMOTE_FETCH_MAX_BYTES=10485760
REMOTE_FETCH_MAX_REDIRECTS=3

# Auth and admission controls. Keep API_KEYS in the secret store, not Git.
API_AUTH_REQUIRED=false
API_KEYS=
# Disabled by default: query-string credentials can leak through proxies and logs.
ALLOW_QUERY_API_KEY=false
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_STORE_MAX=10000

# Use redis only when a Redis service is reachable; memory is the offline default.
QUEUE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379

# Adapter: mock is the offline default. scrapling publishes durable image
# references to the Redis Streams v1 worker contract. Direct Playwright
# automation has been retired from the service.
LENS_ADAPTER=mock
GOOGLE_LENS_LIVE_ENABLED=false
GOOGLE_LENS_LIVE_AUTHORIZED=false
SCRAPLING_RESULT_TIMEOUT_MS=30000
SCRAPLING_POLL_INTERVAL_MS=250
SCRAPLING_WORKER_MODE=disabled
SCRAPLING_HEARTBEAT_MAX_AGE_MS=60000
SCRAPLING_HEARTBEAT_TTL_SECONDS=60
SCRAPLING_MAX_PAGES=1
SCRAPLING_BROWSER_TIMEOUT_MS=30000
