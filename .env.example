NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Upload and execution limits
MAX_IMAGE_BYTES=10485760
MAX_BATCH_SIZE=10
MAX_QUEUE_SIZE=100
WORKER_CONCURRENCY=2
SEARCH_SYNC_WAIT_MS=1000
JOB_RETENTION_MS=3600000
MAX_JOB_RECORDS=1000
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500

# Browser adapter: disabled by default. Tests use the local mock adapter.
LENS_ADAPTER=mock
LENS_TARGET_URL=https://lens.google.com/
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000
GOOGLE_LENS_LIVE_ENABLED=false
GOOGLE_LENS_LIVE_AUTHORIZED=false
